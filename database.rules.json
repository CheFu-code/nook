{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && auth.token.nook === true",
        "sessions": {
          "$sessionId": {
            ".write": "auth != null && auth.token.nook === true && auth.uid === $uid",
            ".validate": "newData.hasChildren(['state', 'lastChanged']) && newData.child('state').val() === 'online'"
          }
        },
        "lastSeen": {
          ".write": "auth != null && auth.token.nook === true && auth.uid === $uid",
          ".validate": "newData.isNumber()"
        }
      }
    },
    "chatEvents": {
      "$uid": {
        ".read": "auth != null && auth.token.nook === true && auth.uid === $uid"
      }
    }
  }
}
