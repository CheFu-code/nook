{
  "expo": {
    "name": "nook",
    "slug": "nook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "nook",
    "userInterfaceStyle": "automatic",
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-2.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "co.za.chefu.nook",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/logo-2.png",
          "imageWidth": 96
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#087EFF",
          "defaultChannel": "messages"
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose photos and videos for your nook posts, stories, and profile.",
          "cameraPermission": "Take photos for your nook posts and stories.",
          "microphonePermission": false
        }
      ],
      "expo-video",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "nook",
          "organization": "chefu-technologies"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "68f53682-efa6-49ce-996d-b25c48f0dea3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/68f53682-efa6-49ce-996d-b25c48f0dea3"
    },
    "ios": {}
  }
}
