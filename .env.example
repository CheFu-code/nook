# Chefu backend API used for centralized OAuth sign-in and Nook requests
EXPO_PUBLIC_API_BASE_URL=https://api.chefu.co.za

# Public Firebase app configuration for authenticated Realtime Database presence.
# Copy these values from the Firebase project web app and Realtime Database console.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=

# Local path to the Firebase Android config for package co.za.chefu.nook.
# In EAS, define GOOGLE_SERVICES_JSON as a file-type environment variable.
GOOGLE_SERVICES_JSON=google-services.json

# Sentry source-map/debug-symbol uploads only; never use an EXPO_PUBLIC_ prefix.
# The wizard stores the real token in .env.local. Set it in each EAS build environment too.
SENTRY_AUTH_TOKEN=
